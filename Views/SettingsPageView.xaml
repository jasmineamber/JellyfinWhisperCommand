<UserControl x:Class="JellyfinWhisperCommand.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JellyfinWhisperCommand.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 头部 -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="设置" Style="{DynamicResource Text.PageTitle}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="{Binding Settings.SaveResult}" Foreground="{DynamicResource Brush.Success}" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button Content="重新加载" Style="{DynamicResource Button.Secondary}" Height="28" Padding="10,0"
                Margin="0,0,8,0" Command="{Binding Settings.ReloadCommand}" />
        <Button Content="保存设置" Style="{DynamicResource Button.Primary}" Height="28" MinWidth="96"
                Command="{Binding Settings.SaveCommand}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="840" HorizontalAlignment="Left" Margin="0,0,8,0">

        <!-- 常规 -->
        <StackPanel Margin="0,0,0,22">
          <TextBlock Text="常规" Style="{DynamicResource Text.SectionTitle}" />
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,12" />
          <CheckBox IsChecked="{Binding ShutdownWhenComplete}" Content="所有任务执行完成后自动关机" />
        </StackPanel>

        <!-- Jellyfin -->
        <StackPanel Margin="0,0,0,22">
          <TextBlock Text="Jellyfin" Style="{DynamicResource Text.SectionTitle}" />
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址 (BaseUrl)" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Settings.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Visibility="Hidden"
                    IsTabStop="False" Focusable="False" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="ApiKey" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                         controls:PasswordBoxBinding.BoundPassword="{Binding Settings.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="测试连接" Style="{DynamicResource Button.Secondary}" Height="28" MinWidth="88"
                      Command="{Binding Settings.TestConnectionCommand}" />
              <TextBlock Text="{Binding Settings.TestResult}" FontSize="12"
                         Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                         Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- 处理 (WhisperJav) -->
        <StackPanel Margin="0,0,0,22">
          <TextBlock Text="处理 (WhisperJav)" Style="{DynamicResource Text.SectionTitle}" />
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="可执行文件路径" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Settings.WhisperJavExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Click="BrowseWhisperJavExe_Click" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="输出目录 (OutputDir)" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.WhisperJavOutputDir, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Margin="0,10,0,0" Click="BrowseWhisperJavOutputDir_Click" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="附加参数 (Args)" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Top" />
            <TextBox Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" Height="110" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Text="{Binding Settings.WhisperJavArgs}" />
          </Grid>
        </StackPanel>

        <!-- 翻译 -->
        <StackPanel Margin="0,0,0,22">
          <TextBlock Text="翻译 (WhisperJavTranslate)" Style="{DynamicResource Text.SectionTitle}" />
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="可执行文件路径" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Settings.TranslateExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Click="BrowseTranslateExe_Click" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.TranslateProvider, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="接口地址 (Endpoint)" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.TranslateEndpoint, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="ApiKey" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="3" Grid.Column="2" Margin="0,10,0,0"
                         controls:PasswordBoxBinding.BoundPassword="{Binding Settings.TranslateApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="模型 (Model)" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.TranslateModel, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="源语言" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.TranslateSourceLanguage, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="目标语言" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.TranslateTargetLanguage, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="语气 (Tone)" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="7" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.TranslateTone, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="指令文件路径" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="8" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.TranslateInstructionsFilePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="8" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Margin="0,10,0,0" Click="BrowseTranslateInstructions_Click" />
          </Grid>
          <CheckBox IsChecked="{Binding Settings.TranslateStream}" Margin="0,12,0,0" Content="启用流式输出" />
        </StackPanel>

        <!-- 后处理 (Seconv) -->
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="后处理 (Seconv)" Style="{DynamicResource Text.SectionTitle}" />
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="可执行文件路径" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Settings.SeconvExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Click="BrowseSeconvExe_Click" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="替换规则 CSV" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.SeconvMultipleReplaceRulesFile, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Margin="0,10,0,0" Click="BrowseSeconvRules_Click" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="输入目录" Style="{DynamicResource Text.Label}" Margin="0,10,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" Text="{Binding Settings.SeconvInputFolder, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="2" Grid.Column="4" Content="浏览" Style="{DynamicResource Button.Secondary}"
                    Height="{DynamicResource Height.Control}" Padding="10,0" Margin="0,10,0,0" Click="BrowseSeconvInputFolder_Click" />
          </Grid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
