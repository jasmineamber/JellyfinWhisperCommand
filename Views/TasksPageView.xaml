<UserControl x:Class="JellyfinWhisperCommand.Views.TasksPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JellyfinWhisperCommand">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 页面标题与全局操作 -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="任务" Style="{DynamicResource Text.PageTitle}" />
        <TextBlock Text="管理当前批量处理任务，查看进度与失败项。"
                   Style="{DynamicResource Text.Label}" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="{Binding RetryFailedTranslationButtonText}" Style="{DynamicResource Button.Secondary}" Height="32" Padding="12,0"
                Margin="0,0,8,0" Command="{Binding RetryFailedTranslationCommand}"
                Visibility="{Binding HasFailedTranslationTasks, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Button Content="清理已结束" Style="{DynamicResource Button.Secondary}" Height="32" Padding="12,0"
                Margin="0,0,8,0" Command="{Binding ClearCompletedTasksCommand}" />
        <Button Content="停止队列" Style="{DynamicResource Button.Danger}" Height="32" Padding="12,0"
                Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding StopCommand}" />
      </StackPanel>
    </Grid>

    <!-- 当前批次摘要 -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Medium}" Padding="18,16" Margin="0,0,0,16"
            Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="当前批次" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BatchProgressText}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding TaskSummaryText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Grid.Row="1" Height="6" Margin="0,14,0,14" Minimum="0" Maximum="1"
                     Value="{Binding TaskProgress, Mode=OneWay}"
                     Visibility="{Binding HasBatchCompletion, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <Border Grid.Row="2" Margin="0,0,0,14" Padding="12,9"
                Background="{DynamicResource Brush.WarningSubtle}"
                BorderBrush="{DynamicResource Brush.Warning}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.Medium}"
                Visibility="{Binding ShowShutdownWhenCompleteStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚡" FontSize="14" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
            <TextBlock Text="所有任务完成后将自动关机" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Warning}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Row="3" Margin="0,0,0,14" Padding="14,10"
                CornerRadius="{DynamicResource Radius.Medium}"
                Background="{DynamicResource Brush.SuccessSubtle}"
                BorderBrush="{DynamicResource Brush.Success}"
                BorderThickness="1"
                Visibility="{Binding HasBatchCompletion, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BatchState}" Value="Partial">
                  <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BatchState}" Value="Failed">
                  <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BatchState}" Value="Stopped">
                  <Setter Property="Background" Value="{DynamicResource Brush.Subtle}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="{Binding BatchStateText}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Success}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BatchState}" Value="Partial">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BatchState}" Value="Failed">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BatchState}" Value="Stopped">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding BatchStateDetailText}" FontSize="12"
                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0" />
          </StackPanel>
        </Border>
        <UniformGrid Grid.Row="4" Columns="5">
          <StackPanel>
            <TextBlock Text="{Binding CompletedTaskCount}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Success}" />
            <TextBlock Text="已完成" Style="{DynamicResource Text.Label}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding RunningTaskCount}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Text="处理中" Style="{DynamicResource Text.Label}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding QueuedTaskCount}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="等待" Style="{DynamicResource Text.Label}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding FailedTaskCount}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Danger}" />
            <TextBlock Text="失败" Style="{DynamicResource Text.Label}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding StoppedTaskCount}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="已停止" Style="{DynamicResource Text.Label}" Margin="0,2,0,0" />
          </StackPanel>
        </UniformGrid>
      </Grid>
    </Border>

    <!-- 空状态 -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                Visibility="{Binding HasTasks, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <Path Data="M12,3 L21,8.5 L21,15.5 L12,21 L3,15.5 L3,8.5 Z M5,9.5 L12,13.5 L19,9.5 M12,13.5 L12,20"
            Stroke="{DynamicResource Brush.TextDisabled}" StrokeThickness="1.5"
            Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />
      <TextBlock Text="暂无任务" FontSize="15" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="0,16,0,0" />
      <TextBlock Text="在媒体库中选择媒体并加入任务，这里会显示批次进度和每个任务的状态。"
                 FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                 TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>

    <!-- 任务筛选与列表 -->
    <Grid Grid.Row="2" Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
       <ListBox Style="{DynamicResource SegmentedListBox}"
                ItemsSource="{Binding TaskFilterOptions}"
                DisplayMemberPath="Name"
                SelectedValuePath="Value"
                SelectedValue="{Binding SelectedTaskFilter}"
                Margin="0,0,0,10" />
      <ScrollViewer x:Name="TaskScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FilteredTaskEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.Medium}" Padding="14,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" CornerRadius="{DynamicResource Radius.Small}" Padding="9,4"
                          VerticalAlignment="Top" Margin="0,0,14,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Subtle}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Phase}" Value="Transcribing"><Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Phase}" Value="Translating"><Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Phase}" Value="PostProcessing"><Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Phase}" Value="Completed"><Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Phase}" Value="Failed"><Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding PhaseText}" FontSize="11" />
                  </Border>

                  <StackPanel Grid.Column="1" MinWidth="0">
                    <TextBlock Text="{Binding MediaName}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Detail}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding QueuePositionText}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,5,0,0" />
                    <ProgressBar Height="4" Margin="0,8,20,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                  IsIndeterminate="{Binding IsIndeterminate}"
                                  Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{DynamicResource Brush.Danger}"
                                TextWrapping="Wrap" Margin="0,6,20,0"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding RetryCountText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                Margin="0,4,20,0"
                                Visibility="{Binding HasRetried, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                HorizontalAlignment="Right"
                                Visibility="{Binding HasRealProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Brush.TextDisabled}"
                               HorizontalAlignment="Right" Margin="0,5,0,0" />
                    <Button Content="取消" Style="{DynamicResource Button.Secondary}" Height="26" Padding="8,0" Margin="0,8,0,0"
                            Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="停止" Style="{DynamicResource Button.Danger}" Height="26" Padding="8,0" Margin="0,8,0,0"
                            Command="{Binding DataContext.StopTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanStop, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="重试" Style="{DynamicResource Button.Secondary}" Height="26" Padding="8,0" Margin="0,8,0,0"
                            Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="查看日志" Style="{DynamicResource Button.Ghost}" Height="26" Padding="8,0" Margin="0,4,0,0"
                            Command="{Binding DataContext.ViewTaskLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
