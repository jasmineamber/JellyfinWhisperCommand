<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- 圆角 -->
  <CornerRadius x:Key="Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">6</CornerRadius>
  <CornerRadius x:Key="Radius.Large">8</CornerRadius>

  <!-- 控件高度 -->
  <sys:Double x:Key="Height.Control">32</sys:Double>
  <GridLength x:Key="Height.TopBar">48</GridLength>
  <GridLength x:Key="Height.StatusBar">28</GridLength>
  <GridLength x:Key="Width.NavRail">176</GridLength>

  <!-- 间距 -->
  <Thickness x:Key="Space.PagePadding">24,20,24,20</Thickness>
  <Thickness x:Key="Space.CardPadding">12</Thickness>

  <!-- 卡片尺寸 -->
  <sys:Double x:Key="Size.PosterCardWidth">160</sys:Double>
  <GridLength x:Key="Size.PosterCardImageHeight">240</GridLength>

</ResourceDictionary>
