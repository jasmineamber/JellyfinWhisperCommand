<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 浮动阴影 -->
  <DropShadowEffect x:Key="Effect.Popup" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#000000" />

  <!-- 文本默认 -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- 标签文本 -->
  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <!-- 区域标题 -->
  <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <!-- 页面标题 -->
  <Style x:Key="Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.PageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- 分隔线 -->
  <Rectangle x:Key="Element.Divider" Height="1" Fill="{DynamicResource Brush.Border}" />

  <!-- 滚动条（细、现代） -->
  <Style x:Key="ScrollBar.Vertical" TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThumbRoot" Background="{DynamicResource Brush.BorderStrong}" CornerRadius="3" Margin="2,0" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.Horizontal" TargetType="ScrollBar">
    <Setter Property="Height" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThumbRoot" Background="{DynamicResource Brush.BorderStrong}" CornerRadius="3" Margin="0,2" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 提示 -->
  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Secondary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Small}"
                  Padding="{TemplateBinding Padding}" Effect="{DynamicResource Effect.Popup}">
            <ContentPresenter  />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
