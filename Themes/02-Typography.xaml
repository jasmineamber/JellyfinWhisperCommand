<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- 字体 -->
  <FontFamily x:Key="Font.App">Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <!-- 字号 -->
  <sys:Double x:Key="FontSize.Small">11</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Secondary">12</sys:Double>
  <sys:Double x:Key="FontSize.CardTitle">13</sys:Double>
  <sys:Double x:Key="FontSize.SectionTitle">12</sys:Double>
  <sys:Double x:Key="FontSize.PageTitle">16</sys:Double>

</ResourceDictionary>
