<Window x:Class="JellyfinWhisperCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jellyfin Whisper 命令执行器" Icon="app-icon.ico" Height="820" Width="1200" MinHeight="600" MinWidth="850"
        Background="#F6F7F9">
  <Grid Margin="24">
    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Jellyfin">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Padding="16" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" CornerRadius="6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="100" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="媒体库" Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding Libraries}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedLibraryId}" MinWidth="200" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="排序方式" Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding SortOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedSort}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="字幕" Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding SubtitleOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding HasSubtitles}" />
              </StackPanel>
              <Button Grid.Column="6" Content="筛选" VerticalAlignment="Bottom" Height="28" Command="{Binding SearchCommand}" />
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding MediaItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="160" Height="260" Margin="0,0,16,16"
                                  Background="White" BorderBrush="#D9DDE3" BorderThickness="1">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Grid>
                              <Grid.RowDefinitions><RowDefinition Height="210" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                              <Image Grid.Row="0" Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                              <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="9,7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Padding="5,2" Background="#1976D2" CornerRadius="3"
                                      Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="已选" Foreground="White" FontSize="12" />
                              </Border>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="#1976D2" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#58616C" FontSize="15"
                       Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>

          <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Foreground="#58616C" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Height="28" Padding="8,2" Margin="0,0,8,0" />
              <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" />
              <Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Height="28" Padding="8,2" Margin="8,0,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="执行所选媒体的 WhisperJav 命令" Command="{Binding GenerateCommand}" Background="#1976D2" Foreground="White"
                    BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="22" Content="&#xE768;" />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="日志">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <CheckBox Content="执行完后关机" IsChecked="{Binding ShutdownWhenComplete}" VerticalAlignment="Center" />
            <Button Content="终止执行" Command="{Binding StopCommand}" Margin="16,0,0,0" Padding="10,3">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="OverridesDefaultStyle" Value="True" />
                  <Setter Property="Background" Value="#C62828" />
                  <Setter Property="Foreground" Value="White" />
                  <Setter Property="BorderBrush" Value="#A61F1F" />
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            RecognizesAccessKey="True" />
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#B71C1C" />
                      <Setter Property="BorderBrush" Value="#8E1616" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Background" Value="#8E1616" />
                      <Setter Property="BorderBrush" Value="#6F1111" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Background" Value="#FCE8E6" />
                      <Setter Property="Foreground" Value="#8A1C14" />
                      <Setter Property="BorderBrush" Value="#D8A39D" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
          <Border Grid.Row="2" Background="#171A1F" BorderBrush="#2B313A" BorderThickness="1" CornerRadius="4" Padding="12">
            <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#D6E1EF"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" Loaded="LogTextBox_Loaded" TextChanged="LogTextBox_TextChanged" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
