<Window x:Class="JellyfinWhisperCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nlog="clr-namespace:NLog.WPF;assembly=NLog.WPF"
        xmlns:controls="clr-namespace:JellyfinWhisperCommand.Controls"
        xmlns:views="clr-namespace:JellyfinWhisperCommand.Views"
        xmlns:vm="clr-namespace:JellyfinWhisperCommand"
        Title="Jellyfin Whisper 命令执行器" Icon="app-icon.ico" Height="820" Width="1100" MinHeight="700" MinWidth="1000"
        Background="{StaticResource Brush.WindowBackground}"
        FontFamily="{StaticResource Font.App}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource Height.TopBar}" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{StaticResource Height.StatusBar}" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource Width.NavRail}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 顶栏 -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Brush.TopBarBackground}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="app-icon.ico" Width="20" Height="20" Margin="0,0,10,0" />
          <TextBlock Text="Jellyfin Whisper" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="2" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionText}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Button Grid.Column="4" Style="{StaticResource Button.Ghost}"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Tasks}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="任务" />
            <Border CornerRadius="10" Padding="5,1" Margin="6,0,0,0"
                    Visibility="{Binding HeaderTaskBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HeaderTaskBadgeIsFailure}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock FontSize="10">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HeaderTaskBadgeIsFailure}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
                <TextBlock.Text>
                  <Binding Path="HeaderTaskBadgeText" />
                </TextBlock.Text>
              </TextBlock>
            </Border>
          </StackPanel>
        </Button>
        <Button Grid.Column="6" Style="{StaticResource Button.Ghost}" ToolTip="执行日志"
                Command="{Binding ToggleLogDrawerCommand}">
          <Path Data="M4,3 L16,3 L16,21 L4,21 Z M7,8 L13,8 M7,12 L13,12 M7,16 L11,16"
                Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform" />
        </Button>
      </Grid>
    </Border>

    <!-- 左导航 -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,10,0,0">
        <RadioButton Style="{StaticResource Nav.Item}" Content="媒体库" GroupName="MainNav"
                     IsChecked="{Binding IsMediaPage, Mode=OneWay}"
                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Media}" />
        <RadioButton Style="{StaticResource Nav.Item}" Content="任务" GroupName="MainNav"
                     IsChecked="{Binding IsTasksPage, Mode=OneWay}"
                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Tasks}" />
        <RadioButton Style="{StaticResource Nav.Item}" Content="设置" GroupName="MainNav"
                     IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageKind.Settings}" />
      </StackPanel>
    </Border>

    <!-- 内容宿主 -->
    <Grid Grid.Row="1" Grid.Column="1" Margin="20">
      <views:MediaPageView Visibility="{Binding IsMediaPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <views:TasksPageView Visibility="{Binding IsTasksPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <views:SettingsPageView Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Brush.StatusBarBackground}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
      <Grid Margin="14,0,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding GlobalTaskStatusText}" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding ActiveTaskStatusText}" FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                   Visibility="{Binding HasActiveTasks, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </Grid>
    </Border>

    <!-- 日志抽屉 -->
    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2"
          Visibility="{Binding IsLogDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border Background="#66000000" MouseLeftButtonDown="DrawerScrim_MouseLeftButtonDown" />
      <Border Width="480" HorizontalAlignment="Right" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="14,0">
            <TextBlock Text="日志" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                       VerticalAlignment="Center" />
            <Button Style="{StaticResource Button.Ghost}" Content="查看日志文件"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="ViewLogFile_Click" />
          </Grid>
          <nlog:NlogRichTextBox Grid.Row="1" x:Name="LogTextBox" Margin="8,0,8,8"
                                 Background="Transparent" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
