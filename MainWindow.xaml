<Window x:Class="JellyfinWhisperCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jellyfin Whisper 命令生成器" Icon="app-icon.ico" Height="820" Width="1200" MinHeight="600" MinWidth="850"
        Background="#F6F7F9">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="16" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="媒体库" Margin="0,0,0,5" />
          <ComboBox ItemsSource="{Binding Libraries}" DisplayMemberPath="Name" SelectedValuePath="Id"
                    SelectedValue="{Binding SelectedLibraryId}" MinWidth="200" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="排序方式" Margin="0,0,0,5" />
          <ComboBox ItemsSource="{Binding SortOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                    SelectedValue="{Binding SelectedSort}" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="字幕" Margin="0,0,0,5" />
          <ComboBox ItemsSource="{Binding SubtitleOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                    SelectedValue="{Binding HasSubtitles}" />
        </StackPanel>
        <Button Grid.Column="6" Content="筛选" VerticalAlignment="Bottom" Height="28" Command="{Binding SearchCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding MediaItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="160" Height="260" Margin="0,0,16,16"
                            Background="White" BorderBrush="#D9DDE3" BorderThickness="1">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="210" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Image Grid.Row="0" Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                        <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="9,7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Padding="5,2" Background="#1976D2" CornerRadius="3"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock Text="已选" Foreground="White" FontSize="12" />
                        </Border>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="#1976D2" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#58616C" FontSize="15"
                 Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Foreground="#58616C" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Margin="0,0,8,0" />
        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" />
        <Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <Button Grid.RowSpan="4" Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,44,14"
            ToolTip="生成命令并复制到剪贴板" Command="{Binding GenerateCommand}" Background="#1976D2" Foreground="White"
            BorderThickness="0" FontSize="24" Content="&#x2398;" />
  </Grid>
</Window>
