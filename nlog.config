<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <extensions>
    <add assembly="NLog.WPF" />
  </extensions>
  <targets>
    <target xsi:type="NLog.WPF" name="wpf" />
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/execution.log"
            archiveFileName="${basedir}/logs/execution.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            layout="${longdate} ${message}"
            appendMode="Append"
            encoding="utf-8" />
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="wpf,file" />
  </rules>
</nlog>
